# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=lottery_user
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=lottery
MYSQL_SSL=false

# --- Emoera OIDC 通行证 ---
# 拿到 client_id / client_secret 后把 PASSPORT_ENABLED 置为 true
PASSPORT_ENABLED=false
OIDC_ISSUER=https://accountapi.emoera.com/api
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3001/callback
OIDC_SCOPE=openid profile email
OIDC_JWKS_URL=https://accountapi.emoera.com/api/.well-known/jwks.json
OIDC_USERINFO_URL=https://accountapi.emoera.com/api/oauth2/userinfo
OIDC_PROVIDER=emoera
