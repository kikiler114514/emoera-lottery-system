# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=lottery_user
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=lottery
MYSQL_SSL=false

# --- Session ---
SESSION_SECRET=change-me-to-random-string
SESSION_MAX_AGE=604800

# --- 限额（可调整） ---
MAX_ROOMS_PER_USER=2
MAX_ACTIVITIES_PER_USER=2
MAX_ROOMS_PER_ACTIVITY=10
MAX_NONLOGIN_PARTICIPANTS=1
ROOM_EXPIRE_DAYS=3

# --- Emoera OIDC 通行证 ---
# 生产环境默认启用。本地开发时可设置为 false 跳过登录。
PASSPORT_ENABLED=true
OIDC_ISSUER=https://accountapi.emoera.com/api
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3001/callback
OIDC_SCOPE=openid profile email
OIDC_JWKS_URL=https://accountapi.emoera.com/api/.well-known/jwks.json
OIDC_USERINFO_URL=https://accountapi.emoera.com/api/oauth2/userinfo
OIDC_PROVIDER=emoera
